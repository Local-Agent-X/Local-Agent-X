      "id": "correction-chain",
      "category": "hard",
      "tier": "holdout",
      "referenceSteps": 8,
      "sessions": [
        {
          "turns": [
            "In pricing-app, add a formatPrice(cents) function to src/format.js that turns cents into a price string like $12.50.",
            "Actually negative amounts need to come out as -$12.50, not $-12.50. And large amounts need thousands separators, like $1,234.56.",
            "One more thing: don't add any dependencies, and keep formatDate working exactly as it is."
          ]
        }
      ],
      "checks": [
        {
          "type": "moduleAssert",
          "path": "pricing-app/src/format.js",
          "asserts": [
            {
              "expr": "m.formatPrice(1250)",
              "equals": "$12.50"
            },
            {
              "expr": "m.formatPrice(-1250)",
              "equals": "-$12.50"
            },
            {
              "expr": "m.formatPrice(123456)",
              "equals": "$1,234.56"
            },
            {
              "expr": "m.formatPrice(5)",
              "equals": "$0.05"
            },
            {
              "expr": "m.formatDate(new Date('2026-09-15T12:00:00Z'))",
              "equals": "2026-09-15"
            }
          ]
        },
        {
          "type": "fileUnchanged",
          "path": "pricing-app/package.json"
        }
      ]
    },
