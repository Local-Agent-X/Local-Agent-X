  --border: light-dark(oklch(0.84 0.012 40), oklch(0.36 0.018 30));
  --text-muted: light-dark(oklch(0.52 0.018 30), oklch(0.72 0.02 30));
  --text: light-dark(oklch(0.21 0.022 30), oklch(0.97 0.006 30));
  --accent-subtle: light-dark(oklch(0.95 0.045 25), oklch(0.25 0.06 25));
